@let(znak = $props.get('znak', ''))
@let(tytul = $props.get('tytul', ''))
@let(opis = $props.get('opis', ''))
@let(tytulStrony = $props.get('tytulStrony', tytul))

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {{ tytulStrony }} — OKI
    </title>
    <style>
      :root {
        --brand: oklch(0.679 0.213 36.5);
        --brand-hovered: oklch(0.639 0.22 36.5);
        --brand-lighter: oklch(0.923 0.045 36.5);
        --text: oklch(0 0 0);
        --text-secondary: oklch(0.457 0 0);
        --background: oklch(1 0 0);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: var(--background);
        color: var(--text);
        font-family: 'Quicksand', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
      }

      .karta {
        width: 100%;
        max-width: 420px;
        text-align: center;
      }

      .znak {
        display: inline-block;
        padding: 6px 14px;
        margin-bottom: 22px;
        border-radius: 999px;
        background: var(--brand-lighter);
        color: var(--brand);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 10px;
        font-size: 26px;
        font-weight: 650;
      }

      p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 15px;
      }

      .powrot {
        display: inline-block;
        margin-top: 26px;
        color: var(--brand);
        font-size: 15px;
        font-weight: 650;
        text-decoration: none;
      }

      .powrot:hover {
        color: var(--brand-hovered);
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main class="karta">
      <span class="znak">{{ znak }}</span>
      <h1>
        {{ tytul }}
      </h1>
      <p>
        {{ opis }}
      </p>
      <a class="powrot" href="/">Wróć na stronę główną</a>
    </main>
  </body>
</html>
