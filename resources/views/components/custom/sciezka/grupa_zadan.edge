@let(zadania = $props.get('zadanie'))
@let(dodatkowe = $props.get('dodatkowe') ?? [])
@let(wyniki = $props.get('wyniki') ?? {})
@let(header = $props.get('header'))
@let(description = $props.get('description'))
@let(isFirst = $props.get('first', true))
@let(isLast = $props.get('last', true))
@let(ileDodatkowych = zadania.filter((z) => dodatkowe.includes(z.idZadania)).length)
@let(ilePodstawowych = zadania.length - ileDodatkowych)
@if(zadania.length > 0)
  <div class="tasks-box {{ isFirst ? 'first' : '' }} {{ isLast ? 'last' : '' }}" x-data="expandable">
    <button
      class="toggle"
      data-toggle
      data-track="grupa-otwarta"
      data-track-grupa="{{ header }}"
      @click="open = !open"
    >
      <span class="box-arrow" :class="{ open }"></span>
      <h3 class="bold">
        {{ header }}
        @if(ileDodatkowych > 0)
          <span class="counter" title="{{ ilePodstawowych }} zwykłych + {{ ileDodatkowych }} dodatkowych">
            ({{ ilePodstawowych }} + {{ ileDodatkowych }})
          </span>
        @else
          <span class="counter">({{ zadania.length }})</span>
        @end
      </h3>
    </button>
    <div class="box" :class="{ open }">
      <div class="box-inner">
        <span class="box-description">{{ description }}</span>
        @each(zadanie in zadania)
          @!custom.sciezka.zadanie({
            zadanie: zadanie,
            dodatkowe: dodatkowe.includes(zadanie.idZadania),
            wynik: wyniki[zadanie.idZadania],
          })
        @end
      </div>
    </div>
  </div>
@end
