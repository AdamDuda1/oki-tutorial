@if(paginator.isEmpty)
  <p class="empty-state">Brak zadań dla wybranych filtrów.</p>
@else
  <table class="zadania-table">
    <thead>
      <tr>
        <th class="col-id">#</th>
        <th>Nazwa</th>
        <th>Źródło</th>
        <th style="width: 200px;"><span style="float: right">Trudność</span></th>
      </tr>
    </thead>
    @each(z in paginator)
      @!custom.listaZadan.zadanie({
        zadanie: z,
        poziomyTrudnosci: poziomyTrudnosci,
        withAlpha: withAlpha,
      })
    @end
  </table>
  @!pagination({
    currentPage: paginator.currentPage,
    totalPages: paginator.lastPage,
    prevUrl: paginator.getPreviousPageUrl(),
    nextUrl: paginator.getNextPageUrl(),
  })
@end
