@layout({ title: task ? 'Edytuj zadanie' : 'Nowe zadanie' })
  @layoutAdminSidebar({ page: task ? 'Edytuj zadanie' : 'Nowe zadanie' })
    @let(isNew = task === null)
    @let(formRoute = isNew ? 'admin.edit_task.store' : 'admin.edit_task.update')
    @let(formParams = isNew ? {} : { id: task.idZadania })

    @let(diffOptions = [
    { value: '', name: '- wybierz -', isSelected: !task || task.idPoziomuTrudnosci === null },
    ...poziomyTrudnosci.map(pt => ({
    value: pt.idPoziomuTrudnosci,
    name: pt.rozwiniecie,
    isSelected: task && task.idPoziomuTrudnosci === pt.idPoziomuTrudnosci,
    })),
    ])

    @let(konkursySzkopul = [
    'oki-olimpiada-zaawansowana',
    'oki-olimpiada-srednio-zaawansowa',
    'oki-olimpiada-od-podstaw',
    'oki-programowanie-od-podstaw',
    ])

    @let(contestOptions = [
    { value: '', name: '- wybierz -', isSelected: !task || !task.szkopulContest },
    ...konkursySzkopul.map(k => ({
    value: k,
    name: k,
    isSelected: task && task.szkopulContest === k,
    })),
    ...(task && task.szkopulContest && !konkursySzkopul.includes(task.szkopulContest)
    ? [{ value: task.szkopulContest, name: task.szkopulContest + ' (spoza listy)', isSelected: true }]
    : []),
    ])

    @if (!isNew)
      <a href="/admin/edit_task" class="back-link" style="margin-bottom: -15px; color: var(--brand);">&lt; wróć</a>
    @end

    <h1>
      {{ isNew ? 'Nowe zadanie' : 'Edytuj zadanie #' + task.idZadania }}
    </h1>
    @if(!isNew)
      <div class="admin-debug-info">
        #{{ task.idZadania }}
  · autor: {{ task.autor ? (task.autor.fullName || task.autor.email) : '-' }}
  · utworzono {{ task.createdAt.setLocale('pl').toFormat('d.LL.yyyy HH:mm') }}
        @if(task.updatedAt)
          · edytowano {{ task.updatedAt.setLocale('pl').toFormat('d.LL.yyyy HH:mm') }}
        @end
      </div>
    @end

    @form({ route: formRoute, routeParams: formParams, method: 'POST', 'data-save-shortcut': true })

      <div class="admin-form-section">
        <h2>
          Podstawowe informacje
        </h2>
        <div class="admin-form-grid">
          <div class="span-2">
            @field.root({ name: 'nazwa' })
              @!field.label({ text: 'Nazwa', required: true })
              @!input.control({ value: task ? task.nazwa : '', required: true })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'zrodlo' })
              @!field.label({ text: 'Źródło', required: true })
              @!input.control({ value: task ? task.zrodlo : '', required: true })
              @!field.error()
            @end
            <details>
              <summary class="underlinable ">
                użycie (rozwiń)
              </summary>
              najczęściej skopiowane z pdf'a, np.:<br />
              VII OIG, zawody II stopnia<br />
              XXXIII OI, etap I (tura szkolna)<br />
              OKI olimpiada od podstaw 25/26<br />
              Mistrz Programowania 2022<br />
              WWI 2018, dzień trzeci<br />
              OKI wakacje 2026
            </details>
          </div>
          <div>
            @field.root({ name: 'idPoziomuTrudnosci' })
              @!field.label({ text: 'Trudność', required: true })
              @!select.control({ options: diffOptions, required: true })
              @!field.error()
            @end
          </div>
          <div class="span-2">
            @field.root({ name: 'tagi' })
              @!field.label({ text: auth.user.canEditAllContent
                ? 'Tagi (nowe dodasz w <a href="/admin/edit_tags" style="color: var(--brand)">Tagi zadań</a>)'
                : 'Tagi' })
              <select id="tagi-select" name="tagi[]" multiple placeholder="Wybierz tagi...">
                @each(t in tagi)
                  <option value="{{ t.nazwa }}" {{ task && task.tagi?.includes(t.nazwa) ? 'selected' : '' }}>
                    {{ t.nazwa }}
                  </option>
                @end
              </select>
              @!field.error()
            @end
          </div>
        </div>
      </div>

      <div class="admin-form-section">
        <h2>
          Linki
        </h2>
        <div class="admin-form-grid">
          <div>
            @field.root({ name: 'linkTresc' })
              @!field.label({ text: '<br>Treść zadania (Z PROBLEMSETU)', required: true })
              @!input.control({ type: 'url', value: task ? task.linkTresc : '', required: true })
              @!field.error()
            @end
          </div>
          <!--div>
          @field.root({ name: 'linkZrodlo' })
          @!field.label({ text: 'Link do źródła' })
          @!input.control({ type: 'url', value: task ? task.linkZrodlo : '' })
          @!field.error()
          @end
          </div-->
          <!--div>
          @field.root({ name: 'linkWyslij' })
          @!field.label({ text: 'Link do wysłania NIE UZUPEŁNIAJ (widok zadania wewnątrz konkursu (kliknij na nazwę zadania w Administracja konkursem > Zadania (<a href="https://szkopul.edu.pl/c/oki-olimpiada-od-podstaw/problemset/problem/9hctKrB7-jbGkh2QhWKQ4hz9/site/?key=statement" style="color: var(--brand)" target="_blank">przykład</a>)))' })
          @!input.control({ type: 'url', value: task ? task.linkWyslij : '' })
          @!field.error()
          @end
          </div-->
          <div>
            @field.root({ name: 'szkopulContest' })
              @!field.label({ text: 'Szkopuł - konkurs. Razem z numerem problemu zastępuje link do wysłania. Uzupełnia się sam z linku.', required: true })
              @!select.control({ options: contestOptions, required: true })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'szkopulPiId' })
              @!field.label({ text: 'Szkopuł - numer problemu w konkursie (ten z linku <code>/submit/.../</code>)', required: true })
              @!input.control({ type: 'number', value: task ? task.szkopulPiId : '', required: true })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'szkopulShortName' })
              @!field.label({ text: 'Szkopuł - skrócona nazwa zadania', required: true })
              @!input.control({ type: 'text', value: task ? task.szkopulShortName : '', required: true })
              @!field.error()
            @end
          </div>
          @if(sprawdzenie)
            <div class="span-2 szkopul-check szkopul-check-{{ sprawdzenie.stan }}">
              <strong>
                Szkopuł: {{ sprawdzenie.tytul }}
    </strong>
              @each(s in sprawdzenie.szczegoly)
                <div>
                  {{ s }}
                </div>
              @end
              @if(task.urlWyslij)
                <div>
                  link „wyślij”:
        <a href="{{ task.urlWyslij }}" target="_blank" rel="noopener">{{ task.urlWyslij }}</a>
                </div>
              @end
            </div>
          @end
          <div>
            @field.root({ name: 'linkOmowienieVid' })
              @!field.label({ text: 'Omówienie wideo (LINK do youtube, najlepiej OKI, ale jeśli nie ma to innego, np olimpiady)' })
              @!input.control({ type: 'url', value: task ? task.linkOmowienieVid : '' })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'linkDodatkoweMaterialy' })
              @!field.label({ text: 'Dodatkowe materiały, na przykład omówienie na stronie olimpiady lub dedykowana strona na oki (<a href="https://oki.org.pl/auto/" style="color: var(--brand)" target="_blank">przykład</a>)' })
              @!input.control({ type: 'url', value: task ? task.linkDodatkoweMaterialy : '' })
              @!field.error()
            @end
          </div>
        </div>
      </div>

      <div class="admin-form-section">
        <h2>
          Treść i rozwiązania
        </h2>
        <div class="admin-form-grid">
          <div class="span-2">
            @field.root({ name: 'hint' })
              @!field.label({ text: 'Podpowiedź (hint); OPCJONALNE: jedno zdanie naprowadzające na rozwiązanie (katex + rich text (linki))' })
              @!textarea.control({ rows: 3, value: task ? task.hint : '' })
              @!field.error()
            @end
          </div>
          <div class="span-2">
            @field.root({ name: 'omowienieText' })
              @!field.label({ text: 'Omówienie tekstowe (katex + rich text (linki))' })
              @!textarea.control({ rows: 4, value: task ? task.omowienieText : '' })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'kodCpp' })
              @!field.label({ text: 'Kod C++; więcej niż jedno rozwiązanie: rozdziel je linią „//// nazwa rozwiązania”' })
              @!textarea.control({ rows: 8, style: 'font-family: var(--font-mono), monospace; font-size: 13px;', value: task ? task.kodCpp : '' })
              @!field.error()
            @end
          </div>
          <div>
            @field.root({ name: 'kodPython' })
              @!field.label({ text: 'Kod Python; więcej niż jedno rozwiązanie: rozdziel je linią „//// nazwa rozwiązania”' })
              @!textarea.control({ rows: 8, style: 'font-family: var(--font-mono), monospace; font-size: 13px;', value: task ? task.kodPython : '' })
              @!field.error()
            @end
          </div>
        </div>
      </div>

      @if(auth.user.canEditAllContent)
        <div style="display: flex; align-items: center; padding-bottom: 2px; gap: 8px;">
          <input
            type="checkbox"
            name="published"
            id="published"
            style="accent-color: var(--brand); width: 18px; height: 18px; cursor: pointer;"
            {{ task && task.published ? 'checked' : '' }}
          />
          <label for="published" style="margin: 0; cursor: pointer;">Opublikowane</label>
        </div>
      @end

      <div style="display: flex; align-items: center; padding-bottom: 2px; gap: 8px;">
        <input
          type="checkbox"
          name="q"
          id="q"
          style="accent-color: var(--brand); width: 18px; height: 18px; cursor: pointer;"
        />
        <label for="q" style="margin: 0; cursor: pointer;">Checkbox który nic nie robi</label>
      </div>

      <div class="admin-form-actions">
        @!button({ text: isNew ? 'Dodaj zadanie' : 'Zapisz zmiany', type: 'submit' })
      </div>
    @end
  </div>
@end
@end
