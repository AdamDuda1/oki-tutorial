@layout({ title: 'Edytuj poziom' })
  @layoutAdminSidebar({ page: 'Edytuj tematy' })
    <a
      href="{{ route('admin.materialy') }}"
      class="back-link"
      style="margin-bottom: -15px; color: var(--brand);"
    >
      &lt; wróć
    </a>

    <h1>
      Edytuj: {{ poziom.nazwa }}
    </h1>
    @form({
      route: 'admin.materialy.update_poziom',
      routeParams: { id: poziom.idPoziomu },
      method: 'POST',
      'data-save-shortcut': true,
    })
      <div class="admin-form-section">
        <h2>
          Podstawowe informacje
        </h2>
        @field.root({ name: 'nazwa' })
          @!field.label({ text: 'Nazwa' })
          @!input.control({ value: poziom.nazwa })
          @!field.error()
        @end
        
        <div style="display: flex; align-items: center; gap: 10px; margin-top: 12px;">
          <input
            type="checkbox"
            name="poboczny"
            id="poboczny"
            style="width: auto; height: 18px; cursor: pointer;"
            {{ poziom.poboczny ? 'checked' : '' }}
          />
          <label for="poboczny" style="margin: 0; cursor: pointer;">
            Intro/Outro - wyświetla się jako temat
          </label>
        </div>
      </div>

      <div class="admin-form-section">
        @field.root({ name: 'customHtml' })
          @!field.label({ text: 'Customowy HTML nad tematami (opcjonalnie)' })
          @!textarea.control({
            rows: 10,
            value: poziom.customHtml ?? '',
            style: 'font-family: var(--font-mono), monospace; font-size: 13px;',
            'data-code-editor': 'html',
          })
        @end
        
        <a
          style="color: var(--brand); cursor: pointer;"
          x-data
          data-help="Możesz używać standardowego formatowania HTML (&lt;b&gt;, &lt;i&gt;, &lt;u&gt;, &lt;a href&gt;, &lt;img&gt;, &lt;table&gt;, ect.). Poza standardowymi tagami, możesz także używać naszych niestandardowych komponentów, np:&#10;&#10;Rozwijana sekcja, tak jak sekcje na zadania:&#10; &#64;custom.sciezka.expandableBox({ title: 'tutaj idzie nagłówek sekcji' })&#10;   tutaj idzie treść&#10; &#64;end"
          @click.stop="$store.modal.show('Formatowanie', $el.dataset.help)"
        >
          Pomoc z formatowaniem &gt;
        </a>
      </div>

      <div class="admin-form-actions">
        @!button({ text: 'Zapisz zmiany', type: 'submit' })
      </div>
    @end
            
    <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--brand-lighter);">
      <h2>
        Usuń poziom
      </h2>
      <p style="font-size: 14px; color: var(--text-secondary); margin: 8px 0 12px;">
        Poziom zniknie ze ścieżki, a jego tematy zostaną odpięte i trafią do sekcji „Bez przypisanego poziomu” (nie zostaną usunięte).
      </p>
      <form
        method="POST"
        action="{{ route('admin.materialy.destroy_poziom', { id: poziom.idPoziomu }) }}"
        data-turbo="false"
        onsubmit="return confirm('Usunąć poziom „{{ poziom.nazwa }}”? Jego tematy zostaną odpięte.')"
      >
        {{ csrfField() }}
        @!button({ text: 'Usuń poziom', type: 'submit' })
      </form>
    </div>
  @end
@end
