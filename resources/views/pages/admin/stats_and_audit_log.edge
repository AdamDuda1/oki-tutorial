@layout({ title: 'Statystyki i historia zmian' })
  @layoutAdminSidebar({ page: 'Statystyki i historia zmian' })
    <div class="admin-edit-task" style="margin-bottom: 24px;">
      <h1>
        Statystyki
      </h1>
      <ul
        style="margin: 0; padding-left: 20px; color: var(--text-secondary); font-size: 14px; display: flex; flex-direction: column; gap: 4px;"
      >
        <li>
          <strong>Zadania:</strong>
          {{ stats.zadania }}
          (opublikowane:
          {{ stats.zadaniaOpublikowane }})
        </li>
        <li>
          <strong>Tematy:</strong>
          {{ stats.tematy }}
          (opublikowane:
          {{ stats.tematyOpublikowane }})
        </li>
        <li>
          <strong>Konta:</strong>{{ stats.uzytkownicy }}
        </li>
      </ul>
    </div>
    @if(umami.enabled)
      <div class="admin-edit-task" style="margin-bottom: 24px;">
        <h1>
          Ruch na stronie
        </h1>
        <a
          href="{{ umami.url }}/websites/{{ umami.websiteId }}"
          target="_blank"
          rel="noopener"
          style="color: var(--brand);"
          class="underlinable"
        >
          otwórz panel Umami
        </a>
      </div>
    @end
    @if(leaderboard.length > 0)
      <div class="admin-edit-task" style="margin-bottom: 24px;">
        <h1>
          Ranking zmian
        </h1>
        <ul
          style="margin: 0; padding-left: 20px; color: var(--text-secondary); font-size: 14px; display: flex; flex-direction: column; gap: 4px;"
        >
          @each(wpis in leaderboard)
            <li>
              <strong>{{ wpis.email }}:</strong>{{ wpis.zmiany }}
            </li>
          @end
        </ul>
      </div>
    @end
    
    <div class="admin-edit-task">
      <h1>
        Audit log
      </h1>
      @let(aktywneFiltry = Object.values(filtry).some(Boolean))
      <form method="GET" action="/admin/stats_and_audit_log" class="audit-filters">
        <input type="search" name="q" value="{{ filtry.q }}" placeholder="Szukaj w opisie, autorze lub #id…" />
        <select name="akcja">
          <option value="">
            każda akcja
          </option>
          @each(a in opcje.akcje)
            <option value="{{ a }}" {{ filtry.akcja === a ? 'selected' : '' }}>
              {{ a }}
            </option>
          @end
        </select>
        <select name="typ">
          <option value="">
            każdy typ
          </option>
          @each(t in opcje.typy)
            <option value="{{ t }}" {{ filtry.typ === t ? 'selected' : '' }}>
              {{ t }}
            </option>
          @end
        </select>
        <label>
          od
          <input type="date" name="od" value="{{ filtry.od }}" />
        </label>
        <label>
          do
          <input type="date" name="do" value="{{ filtry.do }}" />
        </label>
        <button type="submit">
          Szukaj
        </button>
        @if(aktywneFiltry)
          <a href="/admin/stats_and_audit_log" class="clear-link">wyczyść</a>
        @end
      </form>

      @if(paginator.total === 0)
        <p class="empty-state">
          {{ aktywneFiltry ? 'Brak wpisów dla tych filtrów.' : 'Brak wpisów.' }}
        </p>
      @else
        @if(aktywneFiltry)
          <p class="task-count" style="margin-bottom: 8px;">
            Znaleziono {{ paginator.total }}
          </p>
        @end
        <table class="zadania-table">
          <thead>
            <tr>
              <th>
                Kiedy
              </th>
              <th>
                Kto
              </th>
              <th>
                Akcja
              </th>
              <th>
                Co
              </th>
              <th>
                Zmiany
              </th>
            </tr>
          </thead>
          @each(wpis in paginator)
            <tbody x-data>
              <tr>
                <td style="white-space: nowrap;">
                  {{ wpis.createdAt.toFormat('dd.MM.yyyy HH:mm') }}
                </td>
                <td>
                  {{ wpis.uzytkownik }}
                </td>
                <td>
                  {{ wpis.akcja }}
                </td>
                <td>
                  {{ wpis.opis }}
                </td>
                <td>
                  <div style="display: flex; gap: 6px; align-items: center;">
                    @if(roznice[wpis.id])
                      <button
                        type="button"
                        class="audit-diff-toggle underlinable"
                        @click="$store.modal.showHtml($el.dataset.tytul, $el.nextElementSibling.innerHTML)"
                        data-tytul="Zmiany #{{ wpis.id }} - {{ wpis.opis }}"
                      >
                        zmiany ({{ roznice[wpis.id].length }})
                      </button>
                      <template>
                        <div class="audit-diff">
                          @each(pozycja in roznice[wpis.id])
                            <div class="audit-diff-pole">
                              <span class="audit-diff-nazwa">{{ pozycja.pole }}</span>
                              @if(pozycja.roznica.rodzaj === 'linie')
                                <div class="audit-diff-linie">
                                  @each(l in pozycja.roznica.linie)
                                    <div class="audit-diff-linia {{ l.klasa }}">
                                      <span class="audit-diff-znak">{{ l.znak }}</span>                                      <span class="audit-diff-tekst">{{ l.tekst }}</span>
                                    </div>
                                  @end
                                </div>
                              @else
                                <div class="audit-diff-surowe">
                                  <div class="audit-diff-linia usuniete">
                                    <span class="audit-diff-znak">-</span>                                    <span class="audit-diff-tekst">{{ pozycja.roznica.przed }}</span>
                                  </div>
                                  <div class="audit-diff-linia dodane">
                                    <span class="audit-diff-znak">+</span>                                    <span class="audit-diff-tekst">{{ pozycja.roznica.po }}</span>
                                  </div>
                                </div>
                              @end
                            </div>
                          @end
                        </div>
                      </template>
                    @end
                    @if(wpis.czyOdwracalny)
                      /
                      <form
                        method="POST"
                        action="{{ route('admin.stats_and_audit_log.revert', { id: wpis.id }) }}"
                        data-turbo="false"
                        style="display: inline;"
                        onsubmit="return confirm('Cofnąć zmianę #{{ wpis.id }} ({{ wpis.opis }})? Pola {{ wpis.polaDoCofniecia.map(([pole]) => pole).join(', ') }} wrócą do stanu sprzed tej edycji.')"
                      >
                        {{ csrfField() }}
                        <button
                          type="submit"
                          style="background: none; border: none; padding: 0; font: inherit; cursor: pointer; color: var(--brand);"
                          class="underlinable"
                        >
                          cofnij
                        </button>
                      </form>
                    @end
                  </div>
                </td>
              </tr>
            </tbody>
          @end
        </table>
        @!pagination({
          currentPage: paginator.currentPage,
          totalPages: paginator.lastPage,
          prevUrl: paginator.getPreviousPageUrl(),
          nextUrl: paginator.getNextPageUrl(),
        })
      @end
    </div>
  @end
@end
