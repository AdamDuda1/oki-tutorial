@layout({ title: 'Obrazki' })
  @layoutAdminSidebar({ page: 'Obrazki' })
    <div class="admin-edit-task">
      <h1>
        Obrazki
      </h1>
      <p>
        Pliki trzymane są w bazie, więc pojedynczy zrzut bazy jest kompletną kopią -- nie ma
        katalogu, który trzeba archiwizować osobno. Wgraj obrazek, skopiuj gotowy fragment
        i wklej go w treść omówienia.
      </p>

      <form method="POST" action="{{ route('admin.obrazki.store') }}" enctype="multipart/form-data">
        {{ csrfField() }}
        <input type="file" name="obrazek" accept="image/png,image/jpeg,image/gif,image/webp" required />
        <button type="submit">
          Wgraj
        </button>
        <small>PNG, JPEG, GIF lub WebP, do 4 MB.</small>
      </form>

      @if(obrazki.length === 0)
        <p class="empty-state">
          nic tu nie ma :((
        </p>
      @else
        <table class="zadania-table">
          <thead>
            <tr>
              <th class="col-id">
                #
              </th>
              <th>
                Podgląd
              </th>
              <th>
                Nazwa
              </th>
              <th>
                Rozmiar
              </th>
              <th>
                Do wklejenia
              </th>
              <th style="width: 1px; text-align: right;">
                co zrobić?
              </th>
            </tr>
          </thead>
          @each(o in obrazki)
            <tbody class="task-row">
              <tr>
                <td>
                  {{ o.id }}
                </td>
                <td>
                  <a href="{{ o.url }}" target="_blank" rel="noopener">
                    <img src="{{ o.url }}" alt="" style="max-height: 48px; width: auto;" />
                  </a>
                </td>
                <td>
                  {{ o.nazwa }}
                </td>
                <td>
                  {{ o.rozmiarKb }} kB
                </td>
                <td>
                  <input
                    readonly
                    onclick="this.select()"
                    value=img
                    src="{{ o.url }}"
                    style="width: 100%; min-width: 220px;"
                  />' />
                </td>
                <td style="text-align: right;">
                  <form
                    method="POST"
                    action="{{ route('admin.obrazki.destroy', { id: o.id }) }}"
                    onsubmit="return confirm('Usunąć obrazek? Omówienia, które go używają, pokażą pustą ramkę.')"
                  >
                    {{ csrfField() }}
                    <button type="submit" style="background: transparent; padding: 0; width: max-content;">
                      <a style="color: var(--brand)">usuń</a>
                    </button>
                  </form>
                </td>
              </tr>
            </tbody>
          @end
        </table>
      @end
    </div>
  @end
@end
